MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
PORT=5000
# Comma-separate multiple origins if you use preview and production sites.
# Do not include a trailing slash.
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=30d
# Register https://<your-render-service>/api/auth/truecaller/callback in the
# Truecaller developer portal for this partner key.
TRUECALLER_PARTNER_KEY=
TRUECALLER_PARTNER_NAME=ClearTitle One
TRUECALLER_PRIVACY_URL=
TRUECALLER_TERMS_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Optional. Without both values, Ask This Project continues in its deterministic
# evidence-only mode and never sends project content to an AI provider.
OPENAI_API_KEY=
OPENAI_PROJECT_ASSISTANT_MODEL=

# Optional document extraction overrides. Docker deployments install these
# binaries at the default paths; override only for a custom server image.
PDFTOTEXT_BINARY=/usr/bin/pdftotext
PDFINFO_BINARY=/usr/bin/pdfinfo
PDFTOPPM_BINARY=/usr/bin/pdftoppm
TESSERACT_BINARY=/usr/bin/tesseract
DOCUMENT_OCR_MAX_PAGES=80
PASSWORD_RESET_FROM=ClearTitle One <no-reply@your-verified-domain.com>
PROPERTY_EMAIL_FROM=ClearTitle One <no-reply@your-verified-domain.com>
CHANNEL_PARTNER_EMAIL_FROM=ClearTitle One <no-reply@your-verified-domain.com>
CHANNEL_PARTNER_REPLY_TO=feedback@cleartitleone.com

# Channel-partner bank-account encryption. Set a long, random secret in every
# non-test environment and keep it stable; changing it prevents old records
# from being decrypted. Example generator: openssl rand -base64 32
CHANNEL_PARTNER_ENCRYPTION_KEY=
# Keyed hashes allow exact code/mobile lookups without storing searchable plaintext.
CHANNEL_PARTNER_LOOKUP_KEY=

# Increment this whenever the displayed partner/declaration policies change.
CHANNEL_PARTNER_POLICY_VERSION=2026-08-04
